# Set AI_PROVIDER=gemini and provide a Gemini key, or use OpenAI instead.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Alternative provider:
OPENAI_API_KEY=

# Optional; defaults to greentrack.sqlite3 at the repository root.
GREENTRACK_DATABASE=
